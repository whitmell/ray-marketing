# --- Deployment (infrastructure/*.ps1) ---
AWS_REGION=us-east-1
STACK_NAME=ray-marketing
DOMAIN_NAME=marketing.raymatthews.com
HOSTED_ZONE_ID=Z0123456789ABC
COGNITO_USER_EMAIL=you@example.com
PHOTOS_BUCKET=ray-faa-images
# Leave blank to auto-generate
RESOURCES_BUCKET=

# --- Lambda runtime config (passed to CloudFormation) ---
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-20250514

# Optional - Pipeline behavior
THEME_LOOKBACK=2

# AI Scoring providers (used for photo selection)
GEMINI_API_KEY=...
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Meta Graph API - Social publishing
META_PAGE_ACCESS_TOKEN=...
FACEBOOK_PAGE_ID=...
INSTAGRAM_USER_ID=...
META_API_VERSION=v21.0
